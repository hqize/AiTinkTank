# ====================
# MinerU API
# ====================
MINERU_API_TOKEN=xxxxxxxxxxxx
MINERU_BASE_URL=https://mineru.net/api/v4

# ====================
# Object Storage (MinIO)
# ====================
# MinIO 服务端点
MINIO_ENDPOINT=xxx.xxx.xx.xxx:9000
# 访问密钥
MINIO_ACCESS_KEY=xxxxx
# 私有密钥
MINIO_SECRET_KEY=xxxxx
# 存储桶名称
MINIO_BUCKET_NAME=xxxxx
# 图片在MinIO中的目录前缀（不配置时会在图片URL里出现 None/ 这种坏路径）
MINIO_IMG_DIR=images


# ====================
# Vector Database (Milvus)
# ====================
# Milvus 连接地址
MILVUS_URL=http://xxx.xxx.xx.xxx:19530
# 知识库切片集合名
CHUNKS_COLLECTION=xxxxx
# 商品名称集合名
ITEM_NAME_COLLECTION=xxxxx
# 相似度度量方式
MILVUS_METRIC_TYPE=xxxxx
# 最小余弦相似度阈值
MILVUS_MIN_COSINE_SCORE=xxxxx

# ====================
# Document Database (MongoDB)
# ====================
# MongoDB 连接 URL
MONGO_URL=mongodb://xxx.xxx.xx.xx:27017
# 数据库名
MONGO_DB_NAME=xxxxx

# ====================
# OpenAI / LLM API (DashScope compatible)
# ====================
# API 密钥（兼容 OpenAI 格式）
OPENAI_API_KEY=sk-xxxxxxxxxx
# API 基础地址
OPENAI_BASE_URL=https://api.openai-xxxxx/v1
# 默认 LLM 模型
LLM_DEFAULT_MODEL=gpt-4o
# 默认温度参数（0-1，越低越稳定）
LLM_DEFAULT_TEMPERATURE=0.1
# 视觉语言模型
VL_MODEL=o4-mini
# 商品名识别模型
ITEM_MODEL=gpt-4o-mini

# ====================
# BGE Embedding Models
# ====================
# BGE-M3 模型本地路径
BGE_M3_PATH=E:\ai_models\huggingface_cache\bge-m3
# BGE-M3 模型名称
BGE_M3=BAAI/bge-m3
# 嵌入模型运行设备
BGE_DEVICE=cuda:0
# 是否使用半精度（True/False）
BGE_FP16=True
# BGE 重排序模型路径
BGE_RERANKER_LARGE=E:\ai_models\huggingface_cache\bge-reranker-large
# 重排序模型设备
BGE_RERANKER_DEVICE=cuda:0
# 重排序模型半精度
BGE_RERANKER_FP16=1

# ====================
# Embedding General
# ====================
# 嵌入向量维度（OpenAI text-embedding-v4）
EMBEDDING_DIM=1536
# 嵌入模型名称
EMBEDDING_MODEL=text-embedding-v4

# ====================
# Model Source & Cache
# ====================
# 模型来源（ModelScope / HuggingFace）
MINERU_MODEL_SOURCE=modelscope
# ModelScope 离线模式（1=启用）
MODELSCOPE_OFFLINE=1
# ModelScope 模型缓存路径
MODELSCOPE_CACHE=E:/ai_models/modelscope_cache
# Hugging Face 缓存路径
HF_HOME=E:/ai_models/huggingface_cache
# 临时文件根目录
MD_ROOT_DIR=./temp-files/

# ====================
# Other / MCP Services
# ====================
# MCP Web 搜索服务地址
MCP_API_KEY=
MCP_BASE_URL=https://qianfan.baidubce.com/v2/tools/web-search/mcp

# ====================
# 联网搜索实现（两套实现都保留，可随时切换对比）
# ====================
# mcp = 走外部 MCP 服务（上面的百度千帆 webSearch）
# llm = 用大模型自带的联网工具（OpenAI Responses API 的 web_search，不需要额外申请搜索 API）
# off = 关闭联网搜索
# 也可以在单次请求里覆盖：POST /query 带 {"web_search_provider": "llm"}，无需重启
WEB_SEARCH_PROVIDER=mcp
# llm 实现使用的模型与工具类型
WEB_SEARCH_LLM_MODEL=gpt-4o
WEB_SEARCH_LLM_TOOL_TYPE=web_search
# llm 实现最多保留多少条引用来源
WEB_SEARCH_MAX_RESULTS=5

# ====================
# 重排序模型（本地 BGE-Reranker，路径/设备/精度见上面的 BGE Embedding Models 段）
# ====================
# 重排序推理批大小（显存不足时调小）
BGE_RERANKER_BATCH_SIZE=32
# 是否用 sigmoid 归一化到 0~1（1=是）
BGE_RERANKER_NORMALIZE=1

# ====================
# 数据根目录
# ====================
# 上传文件的落盘根目录，实际路径为 <数据根目录>/YYYYMMDD/<task_id>/<文件名>
# 相对路径以 backend/ 目录为基准，因此 ./out 等价于 backend/out
DATA_BASED_ROOT_DIR=./out